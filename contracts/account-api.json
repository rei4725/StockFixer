{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HaltRequest": {
        "properties": {
          "on": {
            "title": "On",
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ],
        "title": "HaltRequest",
        "type": "object"
      },
      "OrderReply": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "reason_code": {
            "anyOf": [
              {
                "enum": [
                  "daily_loss",
                  "position_size",
                  "max_positions",
                  "max_orders",
                  "halted",
                  "invalid",
                  "internal_error"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "status": {
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "OrderReply",
        "type": "object"
      },
      "OrderRequest": {
        "properties": {
          "client_order_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Client Order Id",
            "type": "string"
          },
          "limit_price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Price"
          },
          "market": {
            "enum": [
              "jp",
              "us"
            ],
            "title": "Market",
            "type": "string"
          },
          "order_type": {
            "enum": [
              "market",
              "limit"
            ],
            "title": "Order Type",
            "type": "string"
          },
          "qty": {
            "exclusiveMinimum": 0.0,
            "title": "Qty",
            "type": "integer"
          },
          "reason": {
            "default": "",
            "maxLength": 200,
            "title": "Reason",
            "type": "string"
          },
          "side": {
            "enum": [
              "buy",
              "sell"
            ],
            "title": "Side",
            "type": "string"
          },
          "symbol": {
            "pattern": "^[A-Za-z0-9.\\-]{1,16}$",
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "client_order_id",
          "symbol",
          "market",
          "side",
          "qty",
          "order_type"
        ],
        "title": "OrderRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "StockFixer-account",
    "version": "1"
  },
