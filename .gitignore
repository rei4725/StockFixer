# C#
# .envファイルを全て無視
*.env
[Bb]in/
[Oo]bj/
.vs/
*.suo
*.user

# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints
.mypy_cache/
python/data/
python/models/
Logs/
python/results/

# DuckDB
*.duckdb
*.duckdb.wal

# Coverage reports
python/coverage.json
.coverage
htmlcov/

# Stray log files（Logs/ ディレクトリ配下以外に生成される単発ログ）
*.log

# Security scan reports
bandit-report/

# Pytest temporary files
python/.pytest_tmp/
python/.pytest_tmp_runs/

# AI tool settings (local only — skills/agents は git 管理)
.claude/*
!.claude/skills
!.claude/skills/**
!.claude/agents
!.claude/agents/**
claude起動.bat

# Patch artifacts
*.rej
*.orig

# Experiments lane artifacts (keep code, exclude data artifacts)
python/experiments/**/*.joblib

# OS generated files
.DS_Store
Thumbs.db
*.csv
