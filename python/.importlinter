[importlinter]
root_packages =
    src
# "No matches" な ignore_imports エントリを error ではなく warning として扱う
unmatched_ignores = warn

# ============================================================
# Contract 1: レイヤー階層契約
#   utils < BC群 < orchestration/api
#   上位レイヤーが下位レイヤーを参照するのは合法。逆は禁止。
#
# ignore_imports: 既存違反（将来的な解消対象）を明示列挙。
# 新規違反を追加する際は必ずレビューを経ること。
# ============================================================
[importlinter:contract:layers]
name = Layered architecture (utils < BC < orchestration/api)
type = layers
layers =
    src.api | src.orchestration
    src.backtest | src.prediction | src.trading | src.reporting | src.watchlist | src.market_data | src.rule_engine | src.quality | src.screening
    src.utils
# backtest -> screening: 長期バックテストが screening の純粋関数
# (screen_trend_candidates / simulate_position) を直接参照している既存依存。
# #638 で src.screening を契約対象に追加した際に顕在化した。将来はBT専用
# ポート経由に切り出す想定（Contract 2 のロードマップ [B] 相当）。
ignore_imports =
    src.backtest.longterm_backtest -> src.screening.types
    src.backtest.longterm_backtest -> src.screening.hold_engine
    src.backtest.longterm_backtest -> src.screening.trend_screener

# ============================================================
# Contract 2: BC 独立性契約
#   Bounded Context 同士は相互参照禁止（将来的解消が前提）。
#   ignore_imports に追加する際は必ず理由コメントを付けること。
#
# 違反分類ロードマップ:
#   [A] types.py 共有で解消可能 (短期 Q3-2026):
#       reporting → prediction/watchlist: 共有 types を domain/ に集約
#   [B] イベント/コールバック駆動で解消可能 (中期 Q4-2026):
#       market_data/watchlist/prediction → reporting: 通知をイベント経由に
#       backtest → prediction/market_data: BT 専用ポートを定義
#
# [C] prediction.rule_signal_pipeline → trading/backtest は rule_engine BC (#340) で解消済み
# [D] backtest → screening: BT専用ポート経由に切り出しで解消可能 (中期 Q4-2026、[B]と同分類)
#     #638 で src.screening を契約対象に追加した際に顕在化した既存依存
#
# 削減目標:
#   現状: 47件 (2026-08, #638 で screening 登録により [D] 3件が新規に可視化)
#   Q3-2026: 30件以下 (分類 A を解消)
#   Q4-2026: 20件以下 (分類 B・D を解消)
# ============================================================
[importlinter:contract:independence]
name = BC independence (BCs must not import each other)
type = independence
# utils.db が prediction.db を re-export している間接依存は #338 で根本解消予定
# それまでは indirect check を無効化して direct import のみ検証する
allow_indirect_imports = True
modules =
    src.backtest
    src.prediction
    src.trading
    src.reporting
    src.watchlist
    src.market_data
    src.rule_engine
    src.quality
    src.screening
# backtest -> screening: layers契約と同じ既存依存（詳細はContract 1参照）
ignore_imports =
    src.backtest.longterm_backtest -> src.screening.types
    src.backtest.longterm_backtest -> src.screening.hold_engine
    src.backtest.longterm_backtest -> src.screening.trend_screener
