[importlinter]
root_packages =
    src
# "No matches" な ignore_imports エントリを error ではなく warning として扱う
unmatched_ignores = warn

# ============================================================
# Contract 1: レイヤー階層契約
#   utils < BC群 < orchestration/api
#   上位レイヤーが下位レイヤーを参照するのは合法。逆は禁止。
#
# ignore_imports: 既存違反（将来的な解消対象）を明示列挙。
# 新規違反を追加する際は必ずレビューを経ること。
# ============================================================
[importlinter:contract:layers]
name = Layered architecture (utils < BC < orchestration/api)
type = layers
layers =
    src.api | src.orchestration
    src.backtest | src.prediction | src.trading | src.reporting | src.watchlist | src.market_data | src.rule_engine
    src.utils
ignore_imports =
    # --- BC → orchestration (reporting が scheduler ステータス型を参照) ---
    src.reporting.query_service -> src.orchestration.types
    src.reporting.discord.discord_bot -> src.orchestration.types
    # --- BC 間相互参照 (independence contract でも管理) ---
    src.reporting.query_service -> src.prediction.predict_single
    src.backtest.pipeline -> src.prediction.manager
    src.backtest.portfolio -> src.prediction.manager
    src.backtest.pipeline -> src.market_data.loader
    src.backtest.backtester -> src.market_data.loader
    src.prediction.unified_model_pipeline -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.loader
    # --- 新規追加違反 (将来的解消対象) ---
    src.backtest.rule_backtester -> src.market_data.yf_client
    src.backtest.backtester -> src.market_data.technical
    src.backtest.metrics -> src.market_data.technical
    src.backtest.screener -> src.market_data.yf_client
    src.backtest.portfolio -> src.market_data.market_regime
    src.backtest.pipeline -> src.market_data.technical
    src.prediction.unified_model_pipeline -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.technical
    src.backtest.rule_backtester -> src.market_data.technical
    src.backtest.screener -> src.market_data.technical

# ============================================================
# Contract 2: BC 独立性契約
#   Bounded Context 同士は相互参照禁止（将来的解消が前提）。
#   ignore_imports に追加する際は必ず理由コメントを付けること。
#
# 違反分類ロードマップ:
#   [A] types.py 共有で解消可能 (短期 Q3-2026):
#       reporting → prediction/watchlist: 共有 types を domain/ に集約
#   [B] イベント/コールバック駆動で解消可能 (中期 Q4-2026):
#       market_data/watchlist/prediction → reporting: 通知をイベント経由に
#       backtest → prediction/market_data: BT 専用ポートを定義
#
# [C] prediction.rule_signal_pipeline → trading/backtest は rule_engine BC (#340) で解消済み
#
# 削減目標:
#   現状: 44件 (2026-05, #340 実施後: [C] 3件削減)
#   Q3-2026: 30件以下 (分類 A を解消)
#   Q4-2026: 20件以下 (分類 B を解消)
# ============================================================
[importlinter:contract:independence]
name = BC independence (BCs must not import each other)
type = independence
# utils.db が prediction.db を re-export している間接依存は #338 で根本解消予定
# それまでは indirect check を無効化して direct import のみ検証する
allow_indirect_imports = True
modules =
    src.backtest
    src.prediction
    src.trading
    src.reporting
    src.watchlist
    src.market_data
    src.rule_engine
ignore_imports =
    # [A] reporting → prediction (predict_single のみ残存 — 将来的に解消予定)
    src.reporting.query_service -> src.prediction.predict_single
    # [B] backtest → prediction (バックテストが学習済みモデルを使用 — BT 専用ポート定義で解消可能)
    src.backtest.pipeline -> src.prediction.manager
    src.backtest.portfolio -> src.prediction.manager
    # [B] backtest → market_data (バックテストが OHLCV データを取得 — BT 専用ポートで解消可能)
    src.backtest.pipeline -> src.market_data.loader
    src.backtest.backtester -> src.market_data.loader
    # [B] prediction → market_data (学習パイプラインが OHLCV を取得 — market_data ポート注入で解消可能)
    src.prediction.unified_model_pipeline -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.loader
    # [B] backtest → market_data (技術指標計算 — market_data ポートで解消可能)
    src.backtest.rule_backtester -> src.market_data.yf_client
    src.backtest.backtester -> src.market_data.technical
    src.backtest.metrics -> src.market_data.technical
    src.backtest.screener -> src.market_data.yf_client
    src.backtest.portfolio -> src.market_data.market_regime
    src.backtest.pipeline -> src.market_data.technical
    # [B] prediction → market_data (技術指標計算 — market_data ポートで解消可能)
    src.prediction.unified_model_pipeline -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.technical
    # [B] backtest → market_data (追加技術指標 — ポートで解消可能)
    src.backtest.rule_backtester -> src.market_data.technical
    src.backtest.screener -> src.market_data.technical
