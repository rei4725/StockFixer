[importlinter]
root_packages =
    src

# ============================================================
# Contract 1: レイヤー階層契約
#   utils < BC群 < orchestration/api
#   上位レイヤーが下位レイヤーを参照するのは合法。逆は禁止。
#
# ignore_imports: 既存違反（将来的な解消対象）を明示列挙。
# 新規違反を追加する際は必ずレビューを経ること。
# ============================================================
[importlinter:contract:layers]
name = Layered architecture (utils < BC < orchestration/api)
type = layers
layers =
    src.api | src.orchestration
    src.backtest | src.prediction | src.trading | src.reporting | src.watchlist | src.market_data
    src.utils
ignore_imports =
    # --- BC → orchestration (reporting が scheduler ステータス型を参照) ---
    src.reporting.query_service -> src.orchestration.types
    src.reporting.discord.discord_bot -> src.orchestration.types
    # --- BC 間相互参照 (independence contract でも管理) ---
    src.reporting.types -> src.prediction.types
    src.reporting.query_service -> src.prediction.types
    src.reporting.query_service -> src.prediction.predict_single
    src.reporting.discord.discord_utils -> src.prediction.types
    src.reporting.discord.discord_bot -> src.prediction.types
    src.backtest.pipeline -> src.prediction.manager
    src.backtest.portfolio -> src.prediction.manager
    src.backtest.pipeline -> src.market_data.loader
    src.backtest.backtester -> src.market_data.loader
    src.backtest.stress_test -> src.watchlist.types
    src.backtest.walk_forward_report -> src.watchlist.batch_runner
    src.backtest.optimizer -> src.watchlist.batch_runner
    src.prediction.unified_model_pipeline -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.loader
    src.prediction.training_pipeline -> src.watchlist.batch_runner
    src.prediction.training_pipeline -> src.watchlist.types
    src.prediction.manager -> src.reporting.discord.discord_utils
    src.market_data.pipeline -> src.reporting.discord.discord_utils
    src.market_data.pipeline -> src.watchlist.batch_runner
    # --- 新規追加違反 (将来的解消対象) ---
    src.watchlist.batch_runner -> src.reporting.discord.discord_utils
    src.prediction.rule_signal_pipeline -> src.trading.brokers.base
    src.prediction.rule_signal_pipeline -> src.trading.brokers.paper.paper_broker
    src.reporting.discord.discord_utils -> src.trading.pre_close_alert_service
    src.backtest.rule_backtester -> src.market_data.yf_client
    src.backtest.backtester -> src.market_data.technical
    src.backtest.metrics -> src.market_data.technical
    src.backtest.screener -> src.market_data.yf_client
    src.backtest.portfolio -> src.market_data.market_regime
    src.backtest.pipeline -> src.market_data.technical
    src.prediction.rule_signal_pipeline -> src.backtest.rules
    src.prediction.unified_model_pipeline -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.loader
    src.prediction.rule_signal_pipeline -> src.market_data.yf_client
    src.prediction.training_pipeline -> src.market_data.technical
    src.market_data.pipeline -> src.watchlist.types
    src.backtest.portfolio -> src.trading.signal_generator
    src.backtest.pipeline -> src.trading.signal_generator
    src.backtest.pipeline -> src.reporting.discord.discord_utils
    src.backtest.rule_backtester -> src.market_data.technical
    src.backtest.screener -> src.market_data.technical
    src.prediction.rule_signal_pipeline -> src.market_data.technical
    src.utils.alert_service -> src.reporting.discord.discord_utils
    # --- utils → prediction (後方互換 shim: utils/db/__init__.py が prediction.db を再エクスポート) ---
    src.utils.db -> src.prediction.db
    # --- trading → prediction (注文実行時に予測 DB へ書き込み) ---
    src.trading.execution -> src.prediction.db
    src.trading.pre_close_alert_service -> src.prediction.db
    # --- reporting → prediction (月次レポートがドリフト監視を直接呼び出し) ---
    src.reporting.monthly -> src.prediction.drift_monitor
    # --- trading → market_data (遅延/直接インポートで価格取得) ---
    src.trading.execution -> src.infrastructure.yfinance_market_data_adapter
    src.trading.brokers.paper.paper_broker -> src.market_data.yf_client

# ============================================================
# Contract 2: BC 独立性契約
#   Bounded Context 同士は相互参照禁止（将来的解消が前提）。
#   ignore_imports に追加する際は必ず理由コメントを付けること。
#
# 違反分類ロードマップ:
#   [A] types.py 共有で解消可能 (短期 Q3-2026):
#       reporting → prediction/watchlist: 共有 types を domain/ に集約
#   [B] イベント/コールバック駆動で解消可能 (中期 Q4-2026):
#       market_data/watchlist/prediction → reporting: 通知をイベント経由に
#       backtest → prediction/market_data: BT 専用ポートを定義
#   [C] 設計変更が必要 (長期 2027):
#       prediction.rule_signal_pipeline → trading/backtest: ルールエンジン BC の分離
#
# 削減目標:
#   現状: 48件 (2026-05, #264 実施後: 49→48 件)
#   Q3-2026: 30件以下 (分類 A を解消)
#   Q4-2026: 20件以下 (分類 B を解消)
# ============================================================
[importlinter:contract:independence]
name = BC independence (BCs must not import each other)
type = independence
modules =
    src.backtest
    src.prediction
    src.trading
    src.reporting
    src.watchlist
    src.market_data
ignore_imports =
    # [A] reporting → prediction (予測結果をレポート表示 — types.py 共有で解消可能)
    src.reporting.types -> src.prediction.types
    src.reporting.query_service -> src.prediction.types
    src.reporting.query_service -> src.prediction.predict_single
    src.reporting.discord.discord_utils -> src.prediction.types
    src.reporting.discord.discord_bot -> src.prediction.types
    # [B] backtest → prediction (バックテストが学習済みモデルを使用 — BT 専用ポート定義で解消可能)
    src.backtest.pipeline -> src.prediction.manager
    src.backtest.portfolio -> src.prediction.manager
    # [B] backtest → market_data (バックテストが OHLCV データを取得 — BT 専用ポートで解消可能)
    src.backtest.pipeline -> src.market_data.loader
    src.backtest.backtester -> src.market_data.loader
    # [A] backtest → watchlist (バッチバックテストがウォッチリストを反復 — types 共有で解消可能)
    src.backtest.stress_test -> src.watchlist.types
    src.backtest.walk_forward_report -> src.watchlist.batch_runner
    src.backtest.optimizer -> src.watchlist.batch_runner
    # [B] prediction → market_data (学習パイプラインが OHLCV を取得 — market_data ポート注入で解消可能)
    src.prediction.unified_model_pipeline -> src.market_data.loader
    src.prediction.training_pipeline -> src.market_data.loader
    # [A] prediction → watchlist (バッチ学習がウォッチリストを反復 — types 共有で解消可能)
    src.prediction.training_pipeline -> src.watchlist.batch_runner
    src.prediction.training_pipeline -> src.watchlist.types
    # [B] prediction → reporting (ドリフト検出時に Discord 通知 — イベント駆動で解消可能)
    src.prediction.manager -> src.reporting.discord.discord_utils
    # [B] market_data → reporting (データ収集完了時に Discord 通知 — イベント駆動で解消可能)
    src.market_data.pipeline -> src.reporting.discord.discord_utils
    # [B] market_data → watchlist (バッチデータ収集がウォッチリストを反復 — ポート注入で解消可能)
    src.market_data.pipeline -> src.watchlist.batch_runner
    # [B] watchlist → reporting (バッチ通知 — イベント駆動で解消可能)
    src.watchlist.batch_runner -> src.reporting.discord.discord_utils
    # [C] prediction.rule_signal_pipeline → trading (ルールエンジン BC 分離が必要)
    src.prediction.rule_signal_pipeline -> src.trading.brokers.base
    src.prediction.rule_signal_pipeline -> src.trading.brokers.paper.paper_broker
    # [B] reporting → trading (pre_close_alert — alert BC の切り出しで解消可能)
    src.reporting.discord.discord_utils -> src.trading.pre_close_alert_service
    # [B] backtest → market_data (技術指標計算 — market_data ポートで解消可能)
    src.backtest.rule_backtester -> src.market_data.yf_client
    src.backtest.backtester -> src.market_data.technical
    src.backtest.metrics -> src.market_data.technical
    src.backtest.screener -> src.market_data.yf_client
    src.backtest.portfolio -> src.market_data.market_regime
    src.backtest.pipeline -> src.market_data.technical
    # [C] prediction.rule_signal_pipeline → backtest (ルール共有 — ルール BC 分離で解消可能)
    src.prediction.rule_signal_pipeline -> src.backtest.rules
    # [B] prediction → market_data (技術指標計算 — market_data ポートで解消可能)
    src.prediction.unified_model_pipeline -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.technical
    src.prediction.predict_single -> src.market_data.loader
    src.prediction.rule_signal_pipeline -> src.market_data.yf_client
    src.prediction.training_pipeline -> src.market_data.technical
    # [A] market_data → watchlist (types 共有で解消可能)
    src.market_data.pipeline -> src.watchlist.types
    # [B] backtest → trading (シグナル生成 — trading ポートで解消可能)
    src.backtest.portfolio -> src.trading.signal_generator
    src.backtest.pipeline -> src.trading.signal_generator
    # [B] trading → reporting (発注通知 — イベント駆動で解消可能)
    # [B] backtest → reporting (バックテスト通知 — イベント駆動で解消可能)
    src.backtest.pipeline -> src.reporting.discord.discord_utils
    # [B] backtest → market_data (追加技術指標 — ポートで解消可能)
    src.backtest.rule_backtester -> src.market_data.technical
    src.backtest.screener -> src.market_data.technical
    src.prediction.rule_signal_pipeline -> src.market_data.technical
    # [B] trading → prediction (注文実行/アラートが予測 DB を参照 — イベント駆動で解消可能)
    src.trading.execution -> src.prediction.db
    src.trading.pre_close_alert_service -> src.prediction.db
    # [B] reporting → prediction (月次レポートがドリフト監視を直接呼び出し — コールバック化で解消可能)
    src.reporting.monthly -> src.prediction.drift_monitor
    # [B] trading → market_data (ペーパーブローカーが価格取得 — market_data ポートで解消可能)
    src.trading.brokers.paper.paper_broker -> src.market_data.yf_client
    # [B] trading → market_data (execution が遅延インポートで YFinanceAdapter を使用)
    src.trading.execution -> src.infrastructure.yfinance_market_data_adapter
    # [B] 各 BC → prediction (utils.db/__init__.py が prediction.db を再エクスポートする間接参照)
    #     utils.db → prediction.db を無視することで backtest/market_data 等の間接パスを消去
    src.utils.db -> src.prediction.db
